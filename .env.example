# ---- Microsoft Graph app (Entra ID app registration) ----
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Set to false to skip Graph entirely (AD-only deployments, no Intune/Entra
# app registration needed) - requires AD_LDAP_ENABLED=true below and a
# custom policy.json (see intune-radius-helper's policy.ad-only.example.json).
GRAPH_ENABLED=true

# ---- Identity URN namespace embedded in client cert SAN URIs ----
# Must match what your PKI issues certs with, and must match on both
# freeradius (verify-client-cert.sh) and the helper.
URN_PREFIX=urn:example.com

# ---- FreeRADIUS: sites (NAS clients + per-site VLANs) ----
# Sites are discovered dynamically from these env vars, not a fixed list -
# any NAS_CIDR_<SITE> defines a site (<SITE> can be anything, e.g. BOSTON,
# NY, WAREHOUSE_3 - just needs to be valid in an env var name: letters,
# digits, underscore). Each site needs:
#   NAS_CIDR_<SITE>    - the site's NAS IP(s)/CIDR(s), comma-separated for
#                        multiple, e.g. 172.16.10.0/24,172.16.11.0/24
#   NAS_SECRET_<SITE>  - shared secret for that site's NAS clients (required)
# and optionally, independently:
#   VLAN_ACCESS_WIFI_<SITE> / VLAN_ACCESS_WIRED_<SITE>
#   VLAN_UNTRUST_WIFI_<SITE> / VLAN_UNTRUST_WIRED_<SITE>
# Medium (wifi vs wired) is read from the NAS-Port-Type attribute the
# AP/switch sends (Wireless-802.11 vs Ethernet) - confirm your hardware
# actually sends it before relying on this.
#
# The helper's policy tier (access/untrust/reject - see intune-radius-helper's
# README for the rule engine that decides it) is checked per-request from
# post-auth via check-policy.sh, then this site's + this medium's VLAN is
# assigned. "Access" with no VLAN configured for the matching site+medium is
# a plain accept (no VLAN attribute). "Untrust" with no VLAN configured for
# the matching site+medium rejects instead of leaving an untrusted client on
# an unspecified network.
#
# Examples (delete/replace with your real sites). Each site is independent -
# mix and match which VLANs you set:

# BOSTON: wifi only, both access and untrust tiers
# NAS_CIDR_BOSTON=172.16.10.0/24
# NAS_SECRET_BOSTON=
# VLAN_ACCESS_WIFI_BOSTON=11
# VLAN_UNTRUST_WIFI_BOSTON=253

# NY: wifi only, both tiers
# NAS_CIDR_NY=172.16.23.0/24
# NAS_SECRET_NY=
# VLAN_ACCESS_WIFI_NY=19
# VLAN_UNTRUST_WIFI_NY=254

# CHICAGO: multiple NAS subnets at one site, wifi + wired with different
# tags for each medium
# NAS_CIDR_CHICAGO=172.16.40.0/24,172.16.41.0/24
# NAS_SECRET_CHICAGO=
# VLAN_ACCESS_WIFI_CHICAGO=21
# VLAN_ACCESS_WIRED_CHICAGO=22
# VLAN_UNTRUST_WIFI_CHICAGO=251
# VLAN_UNTRUST_WIRED_CHICAGO=252

# WAREHOUSE_3: wired only, no untrust VLAN configured for this site at all -
# a non-compliant device here gets rejected outright instead of landing on
# an untrust network (no VLAN_UNTRUST_* set for this site's wired medium)
# NAS_CIDR_WAREHOUSE_3=172.16.50.0/24
# NAS_SECRET_WAREHOUSE_3=
# VLAN_ACCESS_WIRED_WAREHOUSE_3=30

FREERADIUS_DEBUG=false

# ---- FreeRADIUS: RadSec (RFC 6614 - RADIUS over TLS) ----
# For a RadSec peer (e.g. a proxy or another RADIUS server) instead of a
# plain UDP NAS. Reuses the same server cert/key/CA already configured above
# (EXPECTED_ISSUER_CN's chain, certs/radius-server.key + -chain.pem) - no
# separate cert needed. Requires mutual TLS: the peer must present a client
# cert signed by that same CA, or the TLS handshake itself is rejected before
# any RADIUS packet is even processed - there is no shared-secret-only mode.
# Not compatible with FREERADIUS_DEBUG=true (TLS sockets need threading,
# which -X debug mode disables) - the container will refuse to start rather
# than silently ignore this. Use FREERADIUS_DEBUG=verbose for threaded,
# still-verbose logging instead.
RADSEC_ENABLED=false
RADSEC_PORT=2083

# RadSec peers are tied to a site, same as NAS_CIDR_<SITE> above - a RadSec
# connection is matched to a client{} block like any other, and that block's
# shortname is what selects the site's VLAN/tier logic in post-auth. Without
# this, a RadSec-arriving request wouldn't match any site and would always
# reject regardless of its actual compliance tier. Comma-separated IP/CIDR;
# add this to whichever of your sites above will have a RadSec peer, e.g.:
# RADSEC_CLIENT_CIDR_BOSTON=10.0.0.5

# ---- FreeRADIUS: guest Wi-Fi via EAP-TTLS/PAP ----
# For guests authenticating with a username/password (via AD) instead of a
# device cert - deliberately independent of intune-radius-helper and the
# Intune/Entra compliance tiers above, since guests have no cert and no
# device identity for the helper to check. Validated by an LDAP bind-as-user
# against AD (the only mechanism that works for this - MSCHAPv2/NTLM bind-as
# does NOT work against AD for FreeRADIUS; this must stay PAP).
PAP_ENABLED=false
PAP_LDAP_SERVER=
PAP_LDAP_PORT=636
PAP_LDAP_USE_SSL=true
# There is currently no way to supply a CA trust anchor for this connection
# (no ca_file/ca_path equivalent) - your AD's PKI almost certainly isn't the
# same one used for EAP-TLS (certs/ca-chain.pem above), so PAP_LDAP_VERIFY_CERT=true
# will only succeed if your DC's LDAPS cert chains to a CA already in the
# container's default system trust store. If not (the common case for an
# internal AD CS root), leave this false - the connection is still
# TLS-encrypted, just without verifying the DC's identity - rather than
# have the ldap module fail to instantiate outright, which crash-loops the
# entire FreeRADIUS server (confirmed the hard way against production - this
# takes down the existing EAP-TLS/RadSec paths too, not just guest PAP).
PAP_LDAP_VERIFY_CERT=false
PAP_LDAP_BASE_DN=
# Low-privilege service account for the LDAP connection/search - Domain
# Users membership is enough, no elevated/delegated permissions needed.
PAP_LDAP_BIND_USERNAME=
PAP_LDAP_BIND_PASSWORD=
# Only members of this group are allowed through - anyone else with valid
# AD credentials but not in this group is rejected.
PAP_LDAP_GROUP_DN=

# Per-site guest VLAN, same pattern as VLAN_ACCESS_WIFI_<SITE> - a site with
# PAP_ENABLED but no VLAN_PAP_WIFI_<SITE> rejects guest requests for that
# site (fail closed, same reasoning as the untrust tier: don't leave an
# unmanaged guest device on an unspecified network).
# VLAN_PAP_WIFI_BOSTON=50

# ---- FreeRADIUS: client cert verification ----
# CN of the CA that issues client certs (checked against cert issuer)
EXPECTED_ISSUER_CN=
ENABLE_CRL_VERIFICATION=false

# ---- Helper: policy ----
# Declarative JSON ruleset (first-match-wins) deciding access/untrust/reject.
# Mount your own at ./config/policy.json (see docker-compose.yaml's
# intune-radius-helper volumes) - copy
# https://github.com/griefersutherland/intune-radius-helper/blob/main/policy.example.json
# as a starting point. If ./config/policy.json doesn't exist, the helper's
# built-in default ruleset is used. See that repo's README for the fact
# reference and rule schema.
POLICY_RULES_FILE=/config/policy.json

# Escape hatch: skip Graph/policy entirely and allow anything FreeRADIUS's
# own cert verification already accepted.
TRUST_CHAIN_FALLBACK=false

# ---- Helper: device blocking (POST /block-device, /unblock-device, GET
# /blocked-devices on the helper) ----
# An explicit MAC/Entra-device-id/AD-SID denylist, checked live ahead of
# TRUST_CHAIN_FALLBACK and the policy engine - for cutting off a stolen or
# terminated device immediately regardless of compliance state. Requires
# CACHE_BACKEND=postgres_redis (set below). With no key set, those endpoints
# refuse every request rather than accept unauthenticated writes - see
# intune-radius-helper's README "Device blocking" section for usage.
ADMIN_API_KEY=

# ---- Helper: optional on-prem AD device lookup (LDAPS) ----
# Requires the device cert to also carry a
# `<URN_PREFIX>:onprem-sid:{{OnPremisesSecurityIdentifier}}` SAN URI (add this
# alongside entra-device-id in the Intune SCEP profile's SAN section - see
# "Client certs (device/user) via Intune SCEP" above). Populates
# ad_device_found/ad_device_enabled facts; the default policy doesn't
# reference them, so this alone changes nothing until your policy.json does.
AD_LDAP_ENABLED=false
AD_LDAP_SERVER=
AD_LDAP_PORT=636
AD_LDAP_USE_SSL=true
AD_LDAP_VERIFY_CERT=true
AD_LDAP_BIND_USERNAME=
AD_LDAP_BIND_PASSWORD=
AD_LDAP_BASE_DN=
AD_LDAP_TIMEOUT_SECONDS=10

# ---- Helper: Graph behavior ----
GRAPH_TIMEOUT_SECONDS=20
GRAPH_MAX_RETRIES=1

# ---- Helper: cache backend ----
CACHE_BACKEND=postgres_redis
LOCAL_CACHE_FIRST=true
LOCAL_CACHE_MAX_AGE_SECONDS=900

POSTGRES_DB=radius_cache
POSTGRES_USER=radius_app
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=300

# ---- Helper: background cache refresh ----
LIVE_LOOKUP_CACHE_SECONDS=300
DEVICE_CACHE_REFRESH_SECONDS=900
USER_CACHE_REFRESH_ENABLED=true
USER_CACHE_REFRESH_SECONDS=1800
USER_CACHE_SOURCE=all

# ---- Helper: stale fallback ----
ALLOW_STALE_CACHE_ON_GRAPH_ERROR=true
MAX_STALE_CACHE_HOURS=24

# ---- Logs ----
INTUNE_AUTH_LOG=/logs/intune-auth.log
